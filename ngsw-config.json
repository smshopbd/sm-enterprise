{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/index.csr.html",
          "/manifest.webmanifest",
          "/icons/**",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/fonts/**",
          "/sm-logo.jpg",
          "/sm-enterprise-splash.png"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "product-images",
      "urls": ["https://res.cloudinary.com/**/image/upload/**"],
      "cacheConfig": {
        "maxSize": 250,
        "maxAge": "30d",
        "strategy": "performance"
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/__*"
  ]
}
